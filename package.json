{
	"name": "api",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"_moduleAliases": {
		"@presentation": "dist/v1/@presentation",
		"@core": "dist/v1/@core"
	},
	"scripts": {
		"dev2": "concurrently \"nodemon\" \"nodemon -x tsoa spec-and-routes\"",
		"dev": "ts-node-dev src/v1/@presentation/server.ts",
		"build": "tsc",
		"start": "NODE_ENV=production node dist/v1/@presentation/server.js",
		"f": "prettier --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
		"tsoa:env": "node scripts/generate-postman-env.js",
		"tsoa:gen": "tsoa routes && tsoa spec",
		"tsoa:gen-public": "tsoa routes -c tsoa.public.json && tsoa spec -c tsoa.public.json",
		"typeorm": "ts-node --esm ./node_modules/typeorm/cli.js",
		"migration:generate": "pnpm typeorm migration:generate src/v1/@presentation/database/migration/CreateUserTable --dataSource src/v1/@presentation/database/data-sources/data-source.v1.ts",
		"migration:run": "pnpm typeorm migration:run --dataSource src/v1/@presentation/database/data-sources/data-source.v1.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@12.4.1",
	"dependencies": {
		"@tsoa/runtime": "^6.6.0",
		"axios": "^1.13.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cors": "^2.8.5",
		"cpf-cnpj-validator": "^1.0.3",
		"crypto-js": "^4.2.0",
		"date-fns": "^4.1.0",
		"dotenv": "^16.5.0",
		"express": "^5.1.0",
		"express-session": "^1.18.1",
		"jsonwebtoken": "^9.0.2",
		"module-alias": "^2.2.3",
		"mysql2": "^3.14.1",
		"node-cache": "^5.1.2",
		"node-cron": "^4.2.0",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.2",
		"sprintf-js": "^1.1.3",
		"swagger-ui-express": "^5.0.1",
		"typeorm": "^0.3.24",
		"uuid": "^11.1.0",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@types/cors": "^2.8.18",
		"@types/crypto-js": "^4.2.2",
		"@types/express": "^5.0.2",
		"@types/express-session": "^1.18.2",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/node": "^22.15.30",
		"@types/sprintf-js": "^1.1.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/ws": "^8.18.1",
		"concurrently": "^9.1.2",
		"nodemon": "^3.1.10",
		"prettier": "^3.5.3",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsoa": "^6.6.0",
		"typescript": "^5.8.3"
	}
}