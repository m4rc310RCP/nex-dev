{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "dist",
    "rootDir": "src",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "paths": {
      "@presentation/*": ["./src/v1/@presentation/*"],
      "@core/*": ["./src/v1/@core/*"]
    }
  },

  "include": [
    "views",
    "public",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.html",
    "src/**/*.css",
		"src/v1/**/*.d.ts",
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}